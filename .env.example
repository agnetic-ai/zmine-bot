# ==========================================
# ZMINE AUTOMATION CONFIGURATION
# ==========================================

# Data Directory (Default: current script directory)
# ZMINE_DATA_DIR=/opt/zmine

# Tor SOCKS5 Proxy Configuration
TOR_PROXY_HOST=127.0.0.1
TOR_PROXY_PORT=9050

# Default Referral Code for Registration
ZMINE_DEFAULT_REF=4VN2PNKK

# AI Solver Configuration (Optional - for complex reasoning quiz)
# Can use OpenAI, 9Router, Ollama, or any OpenAI-compatible API
ZMINE_AI_URL=http://127.0.0.1:20128/v1/chat/completions
ZMINE_AI_KEY=
ZMINE_AI_MODEL=ag/gemini-3.8-flash-low

# Telegram Notification (Optional - to receive backup credentials)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
